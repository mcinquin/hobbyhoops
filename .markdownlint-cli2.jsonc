{
  "config": {
    "default": true,
    "MD013": false,
    "MD024": {
      "siblings_only": true
    },
    "MD033": {
      "allowed_elements": ["br"]
    }
  },
  "globs": ["**/*.md"],
  // Skip everything git ignores: generated output such as Playwright failure
  // reports (e2e/.tmp/**/error-context.md), coverage, local data.
  "gitignore": true,
  "ignores": ["node_modules", ".next", "CHANGELOG.md", "CLAUDE.md"]
}
