# Copier vers .env.local (dev) ou .env (Docker) puis renseigner les valeurs.
# Ne jamais committer de fichier .env contenant des secrets.

# Obligatoire — signature des sessions (32 caractères minimum)
# Générer : openssl rand -hex 32
AUTH_SECRET=

# Optionnel — reconnaissance de cartes par photo (bouton « Analyser » du formulaire).
# Clé API CardSight : compte gratuit (750 appels/mois) sur https://app.cardsight.ai
# CARDSIGHT_API_KEY=
# Quota mensuel affiché en admin (défaut : 750 = tier gratuit). À ajuster si tu passes Pro.
# CARDSIGHT_MONTHLY_QUOTA=750

# Obligatoire en production — token pour POST /api/auth/bootstrap (en-tête X-Bootstrap-Token)
# Générer : openssl rand -hex 32
# BOOTSTRAP_TOKEN=

# Optionnel — cookie Secure (true/false). Par défaut : true en production
# ou, avec TRUST_PROXY=true, si le proxy envoie X-Forwarded-Proto=https.
# COOKIE_SECURE=true

# Optionnel — chemin de la base SQLite dans le projet (défaut : data/hobbyhoops.db)
# HOBBYHOOPS_DB_PATH=data/hobbyhoops.db

# Optionnel — faire confiance aux en-têtes X-Forwarded-For / X-Real-IP.
# À activer uniquement derrière un reverse proxy qui réécrit ces en-têtes.
# TRUST_PROXY=false

# Optionnel — niveau de log Pino (debug, info, warn, error). Défaut : info en prod, debug en dev
# LOG_LEVEL=info
